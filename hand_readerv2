  }
</style>
</head>
<body>

<h1>✋ HAND SIGN READER</h1>

<div class="stage" id="stage">
  <video id="video" autoplay playsinline muted></video>
  <canvas id="canvas" width="640" height="480"></canvas>
  <div class="overlay-msg" id="overlay">
    Click <b>START CAMERA</b> below to begin
  </div>
</div>

<div class="digit" id="digit">—</div>

<div class="status">
  <div class="badge">🖐️ fingers <span id="fingerCount">0</span></div>
  <div class="badge">🔢 number <span id="detectedNumber">—</span></div>
  <div class="badge">⚙️ status <span id="statusText">idle</span></div>
</div>

<button id="startBtn">▶ START CAMERA</button>

<div class="hint">
  <kbd>1</kbd> index · <kbd>2</kbd> index+middle · <kbd>3</kbd> thumb+index+middle ·
  <kbd>4</kbd> four fingers · <kbd>5</kbd> open palm
</div>

<script type="module">
const video        = document.getElementById('video');
const canvas       = document.getElementById('canvas');
const ctx          = canvas.getContext('2d');
const digitEl      = document.getElementById('digit');
const fingerCountEl= document.getElementById('fingerCount');
const detectedEl   = document.getElementById('detectedNumber');
const statusEl     = document.getElementById('statusText');
const startBtn     = document.getElementById('startBtn');
const stage        = document.getElementById('stage');
const overlay      = document.getElementById('overlay');

let landmarker = null;
let stream     = null;
let running    = false;
let rafId      = null;
let lastVideoT = -1;
let lastNumber = null;

async function loadModel() {
  statusEl.textContent = 'loading model…';
  const vision = await import(
    'https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/vision_bundle.mjs'
  );
  const fileset = await vision.FilesetResolver.forVisionTasks(
    'https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm'
  );
  landmarker = await vision.HandLandmarker.createFromOptions(fileset, {
    baseOptions: {
      modelAssetPath:
        'https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task',
      delegate: 'GPU'
    },
    runningMode: 'VIDEO',
    numHands: 1,
    minHandDetectionConfidence: 0.5,
    minHandPresenceConfidence: 0.5,
    minTrackingConfidence: 0.5
  });
  statusEl.textContent = 'model ready';
}

function analyzeHand(lm) {
  const dist = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);
  const wrist = lm[0];

  const idxExt = dist(lm[8],  wrist) > dist(lm[6],  wrist) * 1.05;
  const midExt = dist(lm[12], wrist) > dist(lm[10], wrist) * 1.05;
  const rngExt = dist(lm[16], wrist) > dist(lm[14], wrist) * 1.05;
  const pnkExt = dist(lm[20], wrist) > dist(lm[18], wrist) * 1.05;
  const thumbExt = dist(lm[4], lm[5]) > dist(lm[3], lm[5]) * 1.1;

  const fingers = { thumb: thumbExt, index: idxExt, middle: midExt,
                    ring: rngExt, pinky: pnkExt };
  const count = Object.values(fingers).filter(Boolean).length;
  return { count, fingers };
}

function drawSkeleton(lm) {
  const connections = [
    [0,1],[1,2],[2,3],[3,4],
    [0,5],[5,6],[6,7],[7,8],
    [5,9],[9,10],[10,11],[11,12],
    [9,13],[13,14],[14,15],[15,16],
    [13,17],[17,18],[18,19],[19,20],
    [0,17]
  ];
  ctx.lineWidth = 3;
  ctx.strokeStyle = '#4c8bff';
  ctx.shadowColor = '#4c8bff';
  ctx.shadowBlur = 8;
  for (const [i, j] of connections) {
    ctx.beginPath();
    ctx.moveTo(lm[i].x * canvas.width, lm[i].y * canvas.height);
    ctx.lineTo(lm[j].x * canvas.width, lm[j].y * canvas.height);
    ctx.stroke();
  }
  ctx.shadowBlur = 12;
  for (let i = 0; i < lm.length; i++) {
    const isTip = [4,8,12,16,20].includes(i);
    ctx.beginPath();
    ctx.arc(lm[i].x * canvas.width, lm[i].y * canvas.height,
            isTip ? 7 : 4, 0, Math.PI * 2);
    ctx.fillStyle = isTip ? '#ffd966' : '#ff9f4b';
    ctx.shadowColor = isTip ? '#ffd966' : '#ff9f4b';
    ctx.fill();
  }
  ctx.shadowBlur = 0;
}

function setNumber(n) {
  if (n === lastNumber) return;
  lastNumber = n;
  digitEl.textContent = (n === null) ? '—' : String(n);
  detectedEl.textContent = (n === null) ? '—' : String(n);
  digitEl.classList.add('pop');
  setTimeout(() => digitEl.classList.remove('pop'), 150);
}

function loop() {
  if (!running) return;
  if (video.readyState >= 2 && video.currentTime !== lastVideoT) {
    lastVideoT = video.currentTime;
    let results;
    try {
      results = landmarker.detectForVideo(video, performance.now());
    } catch (e) {
      console.error(e);
      rafId = requestAnimationFrame(loop);
      return;
    }
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    if (results.landmarks && results.landmarks.length > 0) {
      const lm = results.landmarks[0];
      drawSkeleton(lm);
      const { count, fingers } = analyzeHand(lm);
      fingerCountEl.textContent = count;
      if (count >= 1 && count <= 5) setNumber(count);
      else setNumber(null);
      statusEl.textContent =
        ['thumb','index','middle','ring','pinky']
          .filter(f => fingers[f]).join('+') || 'fist';
    } else {
      fingerCountEl.textContent = '0';
      setNumber(null);
      statusEl.textContent = 'no hand';
    }
  }
  rafId = requestAnimationFrame(loop);
}

async function start() {
  startBtn.disabled = true;
  startBtn.textContent = '⏳ Loading…';
  overlay.classList.remove('hidden');
  overlay.innerHTML = 'Loading AI model… (first time only, ~3 seconds)';

  try {
    if (!landmarker) await loadModel();

    overlay.innerHTML = 'Requesting camera permission…';
    stream = await navigator.mediaDevices.getUserMedia({
      video: { width: { ideal: 640 }, height: { ideal: 480 }, facingMode: 'user' },
      audio: false
    });
    video.srcObject = stream;

    await new Promise((resolve, reject) => {
      const t = setTimeout(() => reject(new Error('video timeout')), 8000);
      video.onloadedmetadata = () => { clearTimeout(t); resolve(); };
    });
    await video.play();

    running = true;
    stage.classList.add('active');
    overlay.classList.add('hidden');
    startBtn.textContent = '● RUNNING';
    statusEl.textContent = 'detecting…';
    loop();
  } catch (err) {
    console.error(err);
    running = false;
    startBtn.disabled = false;
    startBtn.textContent = '▶ RETRY';
    overlay.classList.remove('hidden');
    overlay.innerHTML =
      `<div><div class="err">⚠ ${err.name || 'Error'}</div>
       <div style="margin-top:8px;font-size:0.9rem">${err.message}</div></div>`;
    statusEl.textContent = 'error';
  }
}

startBtn.addEventListener('click', start);
window.addEventListener('beforeunload', () => {
  running = false;
  if (rafId) cancelAnimationFrame(rafId);
  if (stream) stream.getTracks().forEach(t => t.stop());
});
</script>
</body>
</html>
"""

# ─────────────────────────────────────────────────────────
#  HTTP SERVER
# ─────────────────────────────────────────────────────────
class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path in ("/", "/index.html", "/hand.html"):
            body = HTML_PAGE.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            # Allow camera + cross-origin for MediaPipe CDN
            self.send_header("Permissions-Policy", "camera=*")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)
        else:
            self.send_response(404)
            self.end_headers()

    def log_message(self, fmt, *args):
        # Quieter logs
        sys.stderr.write("[server] %s\n" % (fmt % args))


def find_free_port(start=8000, end=8100):
    for p in range(start, end):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            try:
                s.bind((HOST, p))
                return p
            except OSError:
                continue
    raise RuntimeError("No free port found in range")


def main():
    global PORT
    PORT = find_free_port(8000, 8100)

    socketserver.TCPServer.allow_reuse_address = True
    httpd = socketserver.TCPServer((HOST, PORT), Handler)

    url = f"http://{HOST}:{PORT}/"
    print("=" * 60)
    print("  ✋  Hand Sign Reader is running!")
    print("=" * 60)
    print(f"  Open in your browser:  {url}")
    print()
    print("  Show 1–5 fingers to the camera.")
    print("  Press Ctrl+C in this terminal to stop.")
    print("=" * 60)

    # Open browser after a short delay so server is ready
    threading.Timer(0.6, lambda: webbrowser.open(url)).start()

    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\n[server] shutting down…")
        httpd.shutdown()
        httpd.server_close()


if __name__ == "__main__":
    main()
